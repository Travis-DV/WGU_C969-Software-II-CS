<Window x:Class="WGU_C969_Software_II_CS.AppointmentForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WGU_C969_Software_II_CS"
        mc:Ignorable="d"
        Title="AppointmentForm" Height="600" Width="800">
    <Window.Resources>
        <Style x:Key="TextBoxInError" TargetType="{x:Type TextBox}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                              Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="12,0" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label x:Name="URLLabel"
                       Grid.Row="0"
                       Margin="0, 5, 0, 2.5"
                       HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                       HorizontalContentAlignment="Center">
                    URLLabel
                </Label>
                <TextBox x:Name="URLTextBox"
                         Grid.Row="1"
                         Margin="0, 2.5, 0, 5"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                         Style="{StaticResource TextBoxInError}">
                    <TextBox.Text>
                        <Binding Path="URL"
                                 UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                            <Binding.ValidationRules><local:BasicTextValidator></local:BasicTextValidator></Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="12,0" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label x:Name="TitleLabel"
                       Grid.Row="0"
                       Margin="0, 5, 0, 2.5"
                       HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                       HorizontalContentAlignment="Center">
                    TitleLabel
                </Label>
                <TextBox x:Name="TitleTextbox"
                         Grid.Row="1"
                         Margin="0, 2.5, 0, 5"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                         Style="{StaticResource TextBoxInError}">
                    <TextBox.Text>
                        <Binding Path="Title"
                                 UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                            <Binding.ValidationRules><local:BasicTextValidator></local:BasicTextValidator></Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="12,0" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Grid.Row="0" Margin="6,0" BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Label x:Name="LocationLabel" 
                               Grid.Column="0" Grid.Row="0"
                               HorizontalAlignment="Right" VerticalAlignment="Center" 
                               Margin="0, 0, 2.5, 0"
                               Padding="0, 5, 0, 2.5"
                               >
                            LocationLabel
                        </Label>
                        <ComboBox x:Name="LocationComboBox"
                                  Grid.Column="1" Grid.Row="0"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                  Margin="2.5, 0, 5, 0" 
                                  Padding="0, 5, 0, 2.5" 
                                  Style="{StaticResource ControlInError}"
                                  SelectedIndex="{Binding SelectedLocationIndex}">
                        </ComboBox>
                        <Label x:Name="ContactLabel"
                               Grid.Row="1" Grid.Column="0"
                               Padding="0, 2.5, 2.5, 2.5"
                               HorizontalAlignment="Right" VerticalAlignment="Center" >
                            ContactLabel
                        </Label>
                        <TextBox x:Name="ContactTextBox" 
                                 Grid.Row="1" Grid.Column="1"
                                 Margin="2.5, 0, 5, 0"
                                 Padding="0, 2.5, 0, 2.5"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                 Style="{StaticResource TextBoxInError}">
                            <TextBox.Text>
                                <Binding Path="Contact"
                                         UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                    <Binding.ValidationRules><local:BasicTextValidator></local:BasicTextValidator></Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <Label x:Name="TypeLabel" 
                               Grid.Column="0" Grid.Row="2"
                               HorizontalAlignment="Right" VerticalAlignment="Center" 
                               Margin="0, 0, 2.5, 0"
                               Padding="0, 2.5, 0, 5">
                            TypeLabel
                        </Label>
                        <ComboBox x:Name="TypeComboBox"
                                  Grid.Column="1" Grid.Row="2"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                  Margin="2.5, 0, 5, 0" 
                                  Padding="0, 2.5, 0, 5" 
                                  Style="{StaticResource ControlInError}"
                                  SelectedIndex="{Binding SelectedTypeIndex}">
                        </ComboBox>
                        
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Column="1" Grid.Row="0" Margin="6,0" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="DescriptionLabel"
                               Grid.Row="0"
                               Padding="0, 5, 0, 5"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                               HorizontalContentAlignment="Center">
                            DescriptionLabel
                        </Label>
                        <TextBox x:Name="DescriptionTextBox"
                                 Grid.Row="1"
                                 Margin="0, 2.5"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                 Style="{StaticResource TextBoxInError}">
                            <TextBox.Text>
                                <Binding Path="Description"
                                         UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                    <Binding.ValidationRules><local:BasicTextValidator></local:BasicTextValidator></Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
        
        <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="12, 0" BorderThickness="0">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Calendar Grid.Column="0"></Calendar>
                <GroupBox Grid.Column="1" Padding="0" Margin="0" BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0" Padding="0" Margin="0" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label x:Name="StartTimeLabel" 
                                       Grid.Column="0" Grid.Row="0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" 
                                       Margin="12,0">
                                    StartTimeLabel
                                </Label>
                                <TextBox x:Name="StartTimeTextBox" 
                                         Grid.Column="1" Grid.Row="0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" 
                                         Margin="12,0" Width="200" 
                                         Style="{StaticResource TextBoxInError}"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto">
                                    <TextBox.Text>
                                        <Binding Path="StartTime"
                                                 UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <ComboBox x:Name="StartComboBox"
                                          Grid.Column="2" Grid.Row="0"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                          Style="{StaticResource ControlInError}"
                                          SelectedIndex="{Binding StartTimeIndex}">
                                </ComboBox>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
