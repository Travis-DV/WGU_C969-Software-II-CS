<Window x:Class="WGU_C969_Software_II_CS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        
        <ComboBox x:Name="LanguagesComboBox" Grid.Row="0" SelectionChanged="LanguageSelectedChanged" VerticalAlignment="Top">
            <ComboBoxItem x:Name="LanguagesComboBoxItemEn">English</ComboBoxItem>
            <ComboBoxItem x:Name="LanguagesComboBoxItemEs">Spanish</ComboBoxItem>
        </ComboBox>
        
        <Button Content="Open Customer" Click="NewCustomerClicked" Grid.Row="1"/>
        <Button Content="Open Appointment" Click="NewAppointmentClicked" Grid.Row="2"/>
        
    </Grid>
</Window>
