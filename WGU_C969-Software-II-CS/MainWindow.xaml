<Window x:Class="WGU_C969_Software_II_CS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900">
    <Window.Resources>
        <Style x:Key="ControlInError" TargetType="{x:Type Control}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                              Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- CUSTOMER LIST GROUPBOX -->
        <GroupBox Grid.Row="0" Grid.Column="0" Margin="12, 5, 12, 2.5" Padding="0" BorderThickness="0">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <ListView 
                    x:Name="CustomerListView" 
                    Grid.Row="0" 
                    SizeChanged="ListView_SizeChanged"
                    SelectedItem="{Binding SelectedCustomer}">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True"
                                  ColumnHeaderToolTip="Customer Information">
                            <GridViewColumn 
                                x:Name="CustomerIDColumn" 
                                Width="25"
                                Header="CustomerIDColumn"
                                DisplayMemberBinding="{Binding ID}" />
                            <GridViewColumn 
                                x:Name="CustomerFirstNameColumn" 
                                Header="CustomerFirstNameColumn"
                                DisplayMemberBinding="{Binding FirstName}" />
                            <GridViewColumn 
                                x:Name="CustomerLastNameColumn" 
                                Header="CustomerLastNameColumn"
                                DisplayMemberBinding="{Binding LastName}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                
                <!-- CUSTOMER LIST BUTTONS GROUPBOX -->
                <GroupBox Grid.Row="1" Grid.Column="0" Margin="12, 5, 12, 0" Padding="0" BorderThickness="0">
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CustomerModButton"
                                Grid.Column="0" Grid.Row="0" Margin="2, 0"
                                Click="CustomerModButtonClicked">ModButton</Button>
                        <Button x:Name="CustomerDeleteButton" 
                                Grid.Column="1" Grid.Row="0" Margin="2, 0"
                                Click="CustomerDeleteButtonClicked">DeleteButton</Button>
                        <Button x:Name="CustomerClearButton" 
                                Grid.Column="2" Grid.Row="0" Margin="2, 0"
                                HorizontalAlignment="Right"
                                Click="CustomerClearButtonClicked">CustomerClearButton</Button>
                        
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
        
        <GroupBox Grid.Row="1" Grid.Column="0" Margin="12, 2.5, 12 5" Padding="0" BorderThickness="0">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Calendar x:Name="DatePickCalendar"
                          Grid.Row="0" 
                          Margin="0,0,0, 5"
                          Style="{StaticResource ControlInError}"
                          SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
                <Button x:Name="DateClearButton" 
                        Grid.Column="0" Grid.Row="1" Margin="2, 0"
                        HorizontalAlignment="Right"
                        Click="DateClearButtonClicked">DateClearButton</Button>
            </Grid>
        </GroupBox>
        
        
        <!-- APPOINTMENT LIST GROUPBOX -->
        <GroupBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="12, 5, 12, 2.5" Padding="0" BorderThickness="0">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <ListView Grid.Row="0" 
                    x:Name="AppointmentListView" 
                    SizeChanged="ListView_SizeChanged"
                    SelectedItem="{Binding SelectedAppointment}">
                    <ListView.View>
                        <GridView AllowsColumnReorder="True"
                                  ColumnHeaderToolTip="Appointment Information">
                            <GridViewColumn 
                                x:Name="AppointmentIDColumn" 
                                Width="25"
                                Header="AppointmentIDColumn"
                                DisplayMemberBinding="{Binding ID}" />
                            <GridViewColumn 
                                x:Name="AppointmentStartTimeColumn" 
                                Width="25"
                                Header="AppointmentStartTimeColumn"
                                DisplayMemberBinding="{Binding StartTime}" />
                            <GridViewColumn 
                                x:Name="AppointmentTitleColumn" 
                                Header="AppointmentTitleColumn"
                                DisplayMemberBinding="{Binding AppointmentTitle}" />
                            <GridViewColumn 
                                x:Name="Detail" 
                                Header="Detail"
                                DisplayMemberBinding="{Binding Detail}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                
                <!-- APPOINTMENT LIST BUTTONS GROUPBOX -->
                <GroupBox Grid.Row="1" Grid.Column="0" Margin="12, 5, 12, 0" Padding="0" BorderThickness="0">
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" x:Name="AppointmentModButton"
                                Margin="20, 10"
                                Click="AppointmentModButtonClicked">ModButton</Button>
                        <Button Grid.Column="1" x:Name="AppointmentDeleteButton"
                                Margin="20, 10"
                                Click="AppointmentDeleteButtonClicked">DeleteButton</Button>
                        
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
