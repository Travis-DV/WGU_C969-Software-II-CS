<Window x:Class="WGU_C969_Software_II_CS.CustomerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WGU_C969_Software_II_CS"
        mc:Ignorable="d"
        Title="CustomerForm" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="TextBoxInError" TargetType="{x:Type TextBox}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={x:Static RelativeSource.Self},
                              Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

            
        <Label x:Name="FirstNameLabel" 
               Grid.Column="0" Grid.Row="0"
               HorizontalAlignment="Right" VerticalAlignment="Center" 
               Margin="12,0">
            FirstNameLabel
        </Label>
        <TextBox x:Name="FirstNameTextBox" 
                 Grid.Column="1" Grid.Row="0"
                 HorizontalAlignment="Left" VerticalAlignment="Center" 
                 Margin="12,0" Width="200" 
                 Style="{StaticResource TextBoxInError}">
            <TextBox.Text>
                <Binding Path=".FirstName"
                         UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                    <Binding.ValidationRules><local:BasicTextValidator></local:BasicTextValidator></Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
    
        <Label x:Name="LastNameLabel" 
               Grid.Column="0" Grid.Row="1"
               HorizontalAlignment="Right" VerticalAlignment="Center" 
               Margin="12,0">
            LastNameLabel
        </Label>
        <TextBox x:Name="LastNameTextBox" 
                 Grid.Column="1" Grid.Row="1"
                 HorizontalAlignment="Left" VerticalAlignment="Center" 
                 Margin="12,0" Width="200">
            <TextBox.Text>
                <Binding Path=".LastName"
                         UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                    <Binding.ValidationRules><local:BasicTextValidator></local:BasicTextValidator></Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        
        <GroupBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" BorderThickness="0" Margin="0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <Label x:Name="AddressLabel" 
                       Grid.Column="1" Grid.Row="0"
                       HorizontalAlignment="Right" VerticalAlignment="Center" 
                       Margin="12,0">
                    AddressLabel
                </Label>
                <TextBox x:Name="AddressTextBox" 
                         Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0"
                         HorizontalAlignment="Left" VerticalAlignment="Center" 
                         Margin="12,0" Width="200" 
                         Style="{StaticResource TextBoxInError}"
                         IsReadOnly="True">
                    <TextBox.Text>
                        <Binding Path=".Address"
                                 UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                
                <Button x:Name="AddressModButton"
                    Grid.Column="1" Grid.Row="1" Margin="2, 0"
                        Click="AddressModButtonClicked">ModButton</Button>
                <Button x:Name="AddressClearButton" 
                        Grid.Column="2" Grid.Row="1" Margin="2, 0"
                        Click="AddressClearButtonClicked">ClearButton</Button>
            </Grid>
        </GroupBox>
        
        <Label x:Name="PhoneNumberLabel" 
               Grid.Column="0" Grid.Row="3"
               HorizontalAlignment="Right" VerticalAlignment="Center" 
               Margin="12,0">
            PhoneNumberLabel
        </Label>
        <TextBox x:Name="PhoneNumberTextBox" 
                 Grid.Column="1" Grid.Row="3"
                 HorizontalAlignment="Left" VerticalAlignment="Center" 
                 Margin="12,0" Width="200" 
                 Style="{StaticResource TextBoxInError}">
            <TextBox.Text>
                <Binding Path=".PhoneNumber"
                         UpdateSourceTrigger="Explicit" ValidatesOnDataErrors="True" NotifyOnValidationError="True">
                    <Binding.ValidationRules><local:PhoneClass></local:PhoneClass></Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        
        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" x:Name="DoneButton" Margin="250, 25"
                Click="DoneButtonClicked">DoneButton</Button>
    </Grid>
</Window>
